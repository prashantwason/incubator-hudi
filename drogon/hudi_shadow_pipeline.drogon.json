{
  "project_name": "hudi_shadow_pipeline",
  "project_hdfs_dir": "/user/hudi/hudi_shadow_pipeline/${UBER_LDAP_UID}/",
  "deployment": {
    "artifacts": {
      "file": "packaging/hudi-utilities-bundle/target/hudi-utilities-bundle_${SCALA_VERSION}-${HUDI_VERSION}.jar",
      "files": []
    },
    "flatten_directories": true,
    "proxyUser": "${PROXY_USER}"
  },
  "launch": {
    "className": "com.uber.hudi.tools.pipeline.HoodieShadowPipeline",
    "jars": [
      "http://artifactory.uber.internal:4587/artifactory/libs-release-local/org/apache/avro/avro/${AVRO_VERSION}/avro-${AVRO_VERSION}.jar",
      "http://artifactory.uber.internal:4587/artifactory/libs-release-local/org/apache/spark/spark-avro_${SCALA_VERSION}/${SPARK_AVRO_VERSION}/spark-avro_${SCALA_VERSION}-${SPARK_AVRO_VERSION}.jar"
    ],
    "args": [
      "--assume-date-partitioning", "${ASSUME_DATE_PARTITIONING}",
      "--base-file-format", "${BASE_FILE_FORMAT}",
      "--bootstrap-with-latest-base-files", "${BOOTSTRAP_WITH_LATEST_BASE_FILES}",
      "--continuous", "${CONTINUOUS}",
      "--create-partition-metafile-without-suffix", "${CREATE_PARTITION_METAFILE_WITHOUT_SUFFIX}",
      "--dataset-name", "${UBER_LDAP_UID}_${DATASET_NAME}",
      "--delete-dest-path", "${DELETE_DEST_PATH}",
      "--dest-path", "${DEST_PATH}/${DATASET_NAME}",
      "--dest-table-type", "${DEST_TABLE_TYPE}",
      "--dest-payload-class", "${DEST_PAYLOAD_CLASS}",
      "--enable-deltastreamer-checkpoint", "${ENABLE_DELTASTREAMER_CHECKPOINT}",
      "--enable-hive-sync", "${ENABLE_HIVE_SYNC}",
      "--end-partition", "${END_PARTITION}",
      "--hive-database", "${HIVE_DATABASE}",
      "--hive-table", "${HIVE_TABLE_NAME}",
      "--instants-per-fetch", "${INSTANTS_PER_FETCH}",
      "--key-generator", "${KEY_GENERATOR}",
      "--max-commits-to-sync", "${MAX_COMMITS_TO_SYNC}",
      "--max-files-per-partition", "${MAX_FILES_PER_PARTITION}",
      "--operation", "${OPERATION}",
      "--partition-columns", "${PARTITION_COLUMNS}",
      "--partition-value-extractor-class", "${PARTITION_VALUE_EXTRACTOR_CLASS}",
      "--properties-filepath", "${PROPERTIES_FILEPATH}",
      "--recordkey-column", "${RECORD_KEY_COLOMN}",
      "--runtime-props", "${RUNTIME_PROPS}",
      "--schemaprovider-class", "${SCHEMA_PROVIDER_CLASS}",
      "--selected-partitions", "${SELECTED_PARTITIONS}",
      "--source-instant-time", "${SOURCE_INSTANT_TIME}",
      "--source-ordering-field", "${SOURCE_ORDERING_FIELD}",
      "--src-path", "${SRC_PATH}",
      "--start-partition", "${START_PARTITION}",
      "--use-source-commit-during-initialization", "${USE_SOURCE_COMMIT_DURING_INITIALIZATION}",
      "--use-source-timeline-during-initialization", "${USE_SOURCE_TIMELINE_DURING_INITIALIZATION}",
      "--userid", "${UBER_LDAP_UID}",
      "--validate-before", "${VALIDATE_BEFORE}",
      "--validate-after", "${VALIDATE_AFTER}",
      "--reuse-hoodie-properties-from-src", "${REUSE_HOODIE_PROPERTIES_FROM_SRC}"
    ],
    "conf": {
      "spark.serializer": "org.apache.spark.serializer.KryoSerializer",
      "spark.yarn.jars.exclusionRegex": ".*hudi.*",
      "spark.driver._extraJavaOptions": "-verbose:class",
      "spark.shuffle.service.enabled": "true",
      "spark.shuffle.compress": "true",
      "spark.shuffle.spill.compress": "true",
      "spark.yarn.maxAppAttempts": "1",
      "spark.yarn.max.executor.failures": "50",
      "spark.dynamicAllocation.enabled": "false",
      "spark.scheduler.minRegisteredResourcesRatio": "0.9",
      "spark.scheduler.maxRegisteredResourcesWaitingTime": "600000",
      "spark.hadoop.fs.permissions.umask-mode": "${UMASK}",
      "spark.executor.instances": "${NUM_EXECUTORS}",
      "spark.uber.executor.logging.verbose": "true",
      "spark.driver.cores": "${DRIVER_CORES}",
      "spark.driver.memory": "${DRIVER_MEMORY}",
      "spark.executor.memory": "${EXECUTOR_MEMORY}",
      "spark.default.parallelism": "12288",
      "spark.driver.maxResultSize": "8g",
      "spark.executor.memoryOverhead": "${EXECUTOR_MEMORY_OVERHEAD}",
      "spark.yarn.access.hadoopFileSystems": "hdfs://ns-krypton-prod-dca1,hdfs://ns-platinum-prod-phx,hdfs://ns-router-prod-phx,hdfs://ns-router-dca1,hdfs://ns-neon-prod-dca1,cfs://ns-cloudlake",
      "spark.hadoop.dfs.checksum.combine.mode" : "COMPOSITE_CRC",
      "spark.hadoop.fs.gs.checksum.type": "CRC32C",
      "spark.razor.disabled": "true"
    },
    "queue": "${QUEUE}",
    "sparkEnv": "SPARK_33",
    "useKeytab": true
  },
  "build": {
    "shell_command": "python3 ./scripts/check_and_build.py packaging/hudi-utilities-bundle ${HUDI_VERSION} ${SCALA_VERSION}",
    "cd_enabled": true
  },
  "variables": {
    "ASSUME_DATE_PARTITIONING": "true",
    "AVRO_VERSION": "1.8.2-UBER",
    "BASE_FILE_FORMAT": "PARQUET",
    "BOOTSTRAP_WITH_LATEST_BASE_FILES": "true",
    "CONTINUOUS": "false",
    "CREATE_PARTITION_METAFILE_WITHOUT_SUFFIX": "true",
    "DATASET_NAME": "",
    "DELETE_DEST_PATH": "false",
    "DEST_PATH": "hdfs://ns-router-prod-phx/uber-data/tables/temp/hudi/hudi_shadow_pipeline",
    "DEST_TABLE_TYPE": "COPY_ON_WRITE",
    "DEST_PAYLOAD_CLASS": "com.uber.marmaray.uber.model.HooverAvroPayload",
    "DRIVER_CORES": "2",
    "DRIVER_MEMORY": "6g",
    "ENABLE_DELTASTREAMER_CHECKPOINT": "false",
    "ENABLE_HIVE_SYNC": "false",
    "END_PARTITION": "",
    "EXECUTOR_MEMORY": "4g",
    "EXECUTOR_MEMORY_OVERHEAD": "1g",
    "HIVE_DATABASE": "huditmp",
    "HIVE_TABLE_NAME": "",
    "HUDI_VERSION": "0.16.4",
    "INSTANTS_PER_FETCH": "1",
    "KEY_GENERATOR": "org.apache.hudi.keygen.SimpleKeyGenerator",
    "MAX_COMMITS_TO_SYNC": "-1",
    "MAX_FILES_PER_PARTITION": "",
    "NUM_EXECUTORS": "32",
    "PARTITION_VALUE_EXTRACTOR_CLASS": "org.apache.hudi.hive.SlashEncodedDayPartitionValueExtractor",
    "PARTITION_COLUMNS": "_hoodie_partition_path",
    "PROPERTIES_FILEPATH": "",
    "PROXY_USER": "hudi",
    "QUEUE": "hadoop-platform-komondor-schemaless-speed",
    "RECORD_KEY_COLOMN": "_row_key",
    "RUNTIME_PROPS": "",
    "SCALA_VERSION": "2.12",
    "SCHEMA_PROVIDER_CLASS": "",
    "SELECTED_PARTITIONS": "",
    "SOURCE_INSTANT_TIME": "",
    "SOURCE_ORDERING_FIELD": "_row_key",
    "SPARK_AVRO_VERSION": "3.3.2-uber-13",
    "SRC_PATH": "",
    "START_PARTITION": "",
    "UBER_LDAP_UID": "",
    "UMASK": "002",
    "USE_SOURCE_COMMIT_DURING_INITIALIZATION": "false",
    "USE_SOURCE_TIMELINE_DURING_INITIALIZATION": "true",
    "VALIDATE_BEFORE": "false",
    "VALIDATE_AFTER": "false",
    "OPERATION": "UPSERT",
    "REUSE_HOODIE_PROPERTIES_FROM_SRC": "true"
  }
}
